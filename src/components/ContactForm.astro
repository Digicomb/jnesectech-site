---
import { customerTypes, serviceOptions } from '../options';

interface Props {
  privacyHref: string;
}
const { privacyHref } = Astro.props;
---

<div class="contact-form-wrap">
<div class="contact-form form-thanks" id="contact-thanks" tabindex="-1" role="status" hidden>
  <svg class="thanks-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" /><path d="M7 12.5l3.2 3.2L17 9" /></svg>
  <h3 class="form-title">Thank you!</h3>
  <p>We've got your message and will get back to you soon.</p>
  <p class="thanks-call">Need us sooner? Call <a href="tel:+15022761858">(502) 276-1858</a>.</p>
</div>
<form class="contact-form" id="contact-form" novalidate>
  <h3 class="form-title">Request a quote or ask a question</h3>
  <div class="field-row">
    <div class="field">
      <label for="cf-name">Full name <span aria-hidden="true">*</span></label>
      <input id="cf-name" name="name" type="text" autocomplete="name" maxlength="120" required />
    </div>
    <div class="field">
      <label for="cf-email">Email <span aria-hidden="true">*</span></label>
      <input id="cf-email" name="email" type="email" autocomplete="email" maxlength="254" required />
    </div>
  </div>
  <div class="field-row">
    <div class="field">
      <label for="cf-phone">Phone</label>
      <input id="cf-phone" name="phone" type="tel" autocomplete="tel" maxlength="30" />
    </div>
    <div class="field">
      <label for="cf-service">What do you need? <span aria-hidden="true">*</span></label>
      <select id="cf-service" name="service" required>
        {serviceOptions.map((o) => <option value={o.value}>{o.label}</option>)}
      </select>
    </div>
  </div>
  <fieldset class="field choice">
    <legend>This is for <span aria-hidden="true">*</span></legend>
    {customerTypes.map((t, i) => (
      <label class="choice-option">
        <input type="radio" name="customer_type" value={t.value} checked={i === 0} required />
        <span>{t.label}</span>
      </label>
    ))}
  </fieldset>
  <div class="field">
    <label for="cf-message">Message <span aria-hidden="true">*</span></label>
    <textarea
      id="cf-message"
      name="message"
      rows="5"
      maxlength="4000"
      required
      placeholder="Tell us about your property and what you would like to protect or improve."></textarea>
  </div>

  <!-- Spam trap: hidden from people, often filled in by bots. -->
  <div class="hp" aria-hidden="true">
    <label for="cf-website">Website</label>
    <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <button class="btn btn-primary" type="submit">Send message</button>
  <p class="form-consent">
    We use your details only to respond to you. Read our <a href={privacyHref}>privacy policy</a>.
  </p>
  <p class="form-status" role="status" aria-live="polite"></p>
</form>
</div>

<script>
  import { SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY } from '../config';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = form.querySelector('.form-status') as HTMLParagraphElement;
  const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  const thanksPanel = document.getElementById('contact-thanks') as HTMLDivElement;

  // Replace the form with the thank-you panel.
  const showThanks = () => {
    form.reset();
    form.hidden = true;
    thanksPanel.hidden = false;
    thanksPanel.focus({ preventScroll: true });
    thanksPanel.scrollIntoView({ behavior: 'smooth', block: 'center' });
  };

  const setStatus = (text: string, kind: 'error' | 'success' | '') => {
    status.textContent = text;
    status.dataset.kind = kind;
  };

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const value = (key: string) => String(data.get(key) ?? '').trim();

    // Bots fill the hidden field; pretend it worked and drop it.
    if (value('website')) {
      showThanks();
      return;
    }

    for (const name of ['name', 'email', 'message']) {
      const input = form.elements.namedItem(name) as HTMLInputElement;
      if (!value(name) || !input.checkValidity()) {
        const label = form.querySelector(`label[for="${input.id}"]`)?.firstChild?.textContent?.trim();
        setStatus(name === 'email' ? 'Please enter a valid email address.' : `Please fill in "${label}".`, 'error');
        input.focus();
        return;
      }
    }

    button.disabled = true;
    setStatus('Sending…', '');

    try {
      const response = await fetch(`${SUPABASE_URL}/rest/v1/jne_contact_requests`, {
        method: 'POST',
        headers: {
          apikey: SUPABASE_PUBLISHABLE_KEY,
          'Content-Type': 'application/json',
          Prefer: 'return=minimal',
        },
        body: JSON.stringify({
          name: value('name'),
          email: value('email'),
          phone: value('phone') || null,
          customer_type: value('customer_type'),
          service: value('service'),
          message: value('message'),
          source: 'homepage',
        }),
      });

      if (!response.ok) {
        throw new Error(`Contact request failed: ${response.status}`);
      }

      setStatus('', '');
      showThanks();
    } catch (error) {
      console.error(error);
      setStatus(
        'Something went wrong sending your message. Please try again, or call us at (502) 276-1858.',
        'error',
      );
    } finally {
      button.disabled = false;
    }
  });
</script>
